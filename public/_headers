# Netlify cache headers
# index.html: never cache so deploys are immediately visible
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets (Vite builds these with content hashes in filename) — cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Frames + videos: cache for a day, can be re-fetched
/frames/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

/gallery/*
  Cache-Control: public, max-age=86400
